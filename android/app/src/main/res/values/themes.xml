<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Jiangshan" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
    <style name="Theme.Jiangshan.Dialog" parent="Theme.AppCompat.Light.Dialog">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:windowMinWidthMajor">85%</item>
        <item name="android:windowMinWidthMinor">85%</item>
        <item name="android:windowSoftInputMode">adjustResize</item>
    </style>
</resources>
