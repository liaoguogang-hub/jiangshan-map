<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scrollbars="vertical"
    android:background="@color/paper">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="考据助手"
            android:textColor="@color/ink"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="通过 MCP 让 AI 把问题考据成年份与地点，再跳进地图"
            android:textColor="#6B6258"
            android:textSize="12sp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="服务器地址"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/hostEdit"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="127.0.0.1"
                android:inputType="text"
                android:padding="10dp"
                android:background="@drawable/box"
                android:textColor="@color/ink"
                android:textColorHint="#8A8278"
                android:singleLine="true" />

            <EditText
                android:id="@+id/portEdit"
                android:layout_width="90dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:hint="端口"
                android:inputType="number"
                android:padding="10dp"
                android:background="@drawable/box"
                android:textColor="@color/ink"
                android:textColorHint="#8A8278"
                android:singleLine="true" />
        </LinearLayout>

        <Button
            android:id="@+id/connectBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="连接" />

        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="未连接"
            android:textColor="#6B6258"
            android:textSize="12sp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="#D9CFC0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="问题"
            android:textColor="@color/ink"
            android:textSize="13sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/questionEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="top"
            android:hint="例如：雪拥蓝关马不前是哪一年？李白和杜甫在哪里相遇？"
            android:minLines="3"
            android:padding="10dp"
            android:textColor="@color/ink"
            android:textColorHint="#8A8278"
            android:textSize="14sp"
            android:background="@drawable/box"
            android:inputType="textMultiLine" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/ex1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="雪拥蓝关"
                android:textSize="11sp" />

            <Button
                android:id="@+id/ex2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="李白与杜甫"
                android:textSize="11sp" />

            <Button
                android:id="@+id/ex3"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:minWidth="0dp"
                android:paddingLeft="0dp"
                android:paddingRight="0dp"
                android:text="赤壁在哪"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/askBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="考据" />

        <ProgressBar
            android:id="@+id/progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <View
            android:id="@+id/resultDivider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:visibility="gone"
            android:background="#D9CFC0" />

        <TextView
            android:id="@+id/answerText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.5"
            android:textColor="@color/ink"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/metaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:lineSpacingMultiplier="1.5"
            android:textColor="#5C5346"
            android:textSize="12sp"
            android:visibility="gone" />

        <Button
            android:id="@+id/openMapBtn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="在地图中打开"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
